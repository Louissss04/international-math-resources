name = "international-math-engagement"
main = "src/index.ts"
compatibility_date = "2026-08-06"

[[d1_databases]]
binding = "DB"
database_name = "international-math-engagement"
database_id = "REPLACE_WITH_D1_DATABASE_ID"

[vars]
# Exact origins only. Add a future custom domain as another comma-separated origin.
CORS_ALLOWED_ORIGINS = "https://louissss04.github.io"
PAGE_PATH_PREFIXES = "/"
DAY_TIME_ZONE = "Asia/Shanghai"
VIEW_BROWSER_DAILY_LIMIT = "500"
VIEW_NETWORK_DAILY_LIMIT = "5000"
LIKE_BROWSER_DAILY_LIMIT = "40"
LIKE_NETWORK_DAILY_LIMIT = "1000"
FEEDBACK_BROWSER_DAILY_LIMIT = "3"
FEEDBACK_NETWORK_DAILY_LIMIT = "20"

# Do not put HASH_SECRET or TURNSTILE_SECRET here. Add them with `wrangler secret put`.
